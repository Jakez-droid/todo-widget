<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="Nouvelle tâche"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="20sp" />

    <RadioGroup
        android:id="@+id/horizon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <RadioButton android:id="@+id/h0" style="@style/Chip" android:text="Auj." />
        <RadioButton android:id="@+id/h1" style="@style/Chip" android:text="Semaine" />
        <RadioButton android:id="@+id/h2" style="@style/Chip" android:text="Plus tard" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/pin"
            style="@style/Chip"
            android:text="Épingler en haut" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Supprimer"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_ok"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/add_bg"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/on_accent"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/backup_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_export"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="Sauvegarder"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_import"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="Restaurer"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
