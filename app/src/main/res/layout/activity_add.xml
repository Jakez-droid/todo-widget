<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="Nouvelle tâche"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/horizon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/h0" style="@style/Chip" android:text="Auj." />
            <RadioButton android:id="@+id/h1" style="@style/Chip" android:text="Semaine" />
            <RadioButton android:id="@+id/h2" style="@style/Chip" android:text="Plus tard" />
        </RadioGroup>

        <TextView
            android:id="@+id/btn_ok"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/add_bg"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/on_accent"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
